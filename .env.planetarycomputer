TITILER_OPENEO_STAC_API_URL="https://planetarycomputer.microsoft.com/api/stac/v1"
TITILER_OPENEO_STORE_URL="services/planetarycomputer.json"
# `noaa-c-cap` advertises a provider url of "https//planetarycomputer.microsoft.com"
# — no colon — which fails openEO's response validation and so takes the whole
# GET /collections response down with it. Verified upstream 2026-08-10; drop this
# line once Microsoft fixes the collection metadata.
TITILER_OPENEO_EXCLUDE_COLLECTIONS="noaa-c-cap"
# Planetary Computer asset access
# https://planetarycomputer.microsoft.com/docs/concepts/sas/
#
# No credentials are needed. Blob assets are private, but the SAS tokens that
# unlock them are minted anonymously and attached to each href automatically.
# This line is what switches that on -- required since 0.18.0, where signing
# stopped being inferred from the STAC API hostname (issue #377).
# See docs/adr/0005-asset-href-signing.md.
TITILER_OPENEO_ASSET_SIGNER="planetary-computer"
#
# Optional: raises SAS API rate limits. It does not change what a token grants.
# TITILER_OPENEO_PC_SUBSCRIPTION_KEY=<your_subscription_key>
#
# Note there is deliberately no AWS_* block here: Planetary Computer serves its
# assets as HTTPS blob URLs read through /vsicurl/, not S3.
#
# User identity — Microsoft Entra ID.
# Left OFF by default so Planetary Computer works with no setup at all. While it
# is off the backend runs basic auth, and GET /credentials/oidc returns 404 by
# design: openEO backends advertise only the method they are configured for, so
# only /credentials/basic exists. Uncomment the block below to switch.
#
# The WK_URL must be SINGLE-TENANT. The multi-tenant `common` endpoint returns a
# templated issuer that cannot be validated; the backend refuses it and says so.
# Incomplete config now fails at startup rather than on the first request.
# See docs/src/openid-connect.md#microsoft-entra-id
#
# TITILER_OPENEO_AUTH_METHOD=oidc
# TITILER_OPENEO_AUTH_OIDC_CLIENT_ID=<application (client) ID>
# TITILER_OPENEO_AUTH_OIDC_WK_URL=https://login.microsoftonline.com/<tenant_id>/v2.0/.well-known/openid-configuration
# TITILER_OPENEO_AUTH_OIDC_REDIRECT_URL=http://localhost:8080/
# TITILER_OPENEO_AUTH_OIDC_NAME_CLAIM=preferred_username
# TITILER_OPENEO_AUTH_OIDC_TITLE=Microsoft Entra ID
# Entra needs its own API scope exposed on the app registration, otherwise it
# issues a Microsoft Graph access token whose signature no one but Graph can
# verify. Expose an API (`api://<client_id>`), add a scope, and set
# "requestedAccessTokenVersion": 2 in the manifest. Then:
# TITILER_OPENEO_AUTH_OIDC_AUDIENCES=api://<client_id>
#
# TITILER_OPENEO_AUTH_OIDC_SCOPES=openid profile email api://<client_id>/openeo
#
# Note the openEO PYTHON client drops that scope by default: it intersects the
# scopes advertised here with Entra's fixed `scopes_supported`, which never
# lists custom API scopes. A five-line client-side patch restores it — see
# docs/src/openid-connect.md.
# GDAL performance tuning
CPL_VSIL_CURL_CACHE_SIZE=200000000 # Global LRU cache size
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR # Required: signed hrefs carry a query string
GDAL_HTTP_MULTIPLEX=TRUE # Enable HTTP multiplexing
GDAL_HTTP_VERSION=2 # Blob storage speaks HTTP/2
GDAL_CACHEMAX=500 # Set GDAL cache size
GDAL_INGESTED_BYTES_AT_OPEN=32768 # Open a larger bytes range when reading
GDAL_HTTP_MERGE_CONSECUTIVE_RANGES=YES # Merge consecutive ranges
# 512 MB PER FILE-HANDLE — local/dev only (single user, low concurrency). Do NOT
# use this in k8s/prod: it multiplies by every concurrently open file handle and
# will OOM a pod. The Helm chart default is 5 MB. See docs/src/memory-tuning.md.
VSI_CACHE_SIZE=536870912 # Set VSI cache size
VSI_CACHE=TRUE # Enable VSI cache
